# === Aplicação ===
APP_ENV=dev                       # dev | staging | prod

# === HTTP (API) ===
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=15s

# === Métricas (worker) ===
# A API expõe /metrics no próprio HTTP_ADDR; o worker expõe /metrics + /healthz aqui.
METRICS_ADDR=:9090

# === Banco (Postgres) ===
DATABASE_URL=postgres://trophy:trophy@localhost:5432/trophy?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MIGRATE_ON_START=true

# === Redis (lock do scheduler entre réplicas do worker) ===
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# === Auth (Keycloak realm platform) ===
# PRODUÇÃO: AUTH_MODE=oidc (default) valida iss + aud + role no JWT; exige AUTH_ISSUER e
#   AUTH_AUDIENCE preenchidos. Exemplo de issuer:
#     AUTH_ISSUER=https://auth.rodolfodebonis.com.br/realms/platform
#
# DEV LOCAL: o bypass por header X-Debug-User só é aceito com AUTH_MODE=dev E APP_ENV=dev E
#   AUTH_ISSUER vazio (nunca escorrega para prod por engano). Deixe AUTH_ISSUER em branco abaixo.
AUTH_MODE=dev
AUTH_ISSUER=
AUTH_AUDIENCE=trophy-hunter-api
AUTH_REQUIRED_ROLE=trophy-hunter-user

# === Criptografia das credenciais (AES-256-GCM) ===
# TOKEN_ENC_KEY: 32 bytes em base64. Gere com: openssl rand -base64 32
# (este é um valor de DEV; use um segredo do Vault em produção.)
TOKEN_ENC_KEY=ZGV2LW9ubHktMzItYnl0ZS1rZXktZGV2LW9ubHktISE=
TOKEN_ENC_KEY_VERSION=1
# Rotação de chave: chaves ANTIGAS ainda usadas para DECIFRAR blobs já gravados, no formato
# "version:base64,version:base64". A cifragem nova usa sempre TOKEN_ENC_KEY (a primária). Ex.:
# TOKEN_ENC_KEYS_OLD=1:<base64-da-chave-antiga>
TOKEN_ENC_KEYS_OLD=

# === Sync ===
SYNC_ENABLED=true
SYNC_INTERVAL=6h
WORKER_CONCURRENCY=4
# Orçamento por job na fila (sync_platform lista a biblioteca; cada sync_game faz ~3 chamadas).
JOB_TIMEOUT=5m

# === Steam ===
# STEAM_API_BASE_URL permite apontar a um servidor fake em testes/smoke. Produção: padrão abaixo.
STEAM_API_BASE_URL=https://api.steampowered.com
STEAM_LANG=brazilian
# Teto de requests/seg do token bucket por processo. Com o fan-out, 4 mantém o sync responsivo.
STEAM_RPS=4

# === Telemetria ===
# OTel fica desligado por padrão; as métricas de produto são Prometheus (/metrics).
OTEL_ENABLED=false
OTEL_SERVICE_NAME=trophy-hunter-api
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
LOG_LEVEL=info
